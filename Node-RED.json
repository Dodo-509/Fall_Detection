    {
        "id": "fbb443fb896b47b0",
        "type": "ui_template",
        "z": "866d5d6e1c17e532",
        "group": "sh_group",
        "name": "Vidéos",
        "order": 2,
        "width": "12",
        "height": "6",
        "format": "<div style=\"text-align: center; padding: 10px; background-color: #1e1e1e; border-radius: 8px; color: white;\">\n\n    <div style=\"margin-bottom: 15px; padding: 8px; border-radius: 4px;\"\n        ng-style=\"msg.payload.status === 'fall_detected' ? {'background-color': '#8b0000'} : {'background-color': '#006400'}\">\n        <span ng-if=\"msg.payload.status === 'fall_detected'\">⚠️ ALERTE : CHUTE DETECTÉE</span>\n        <span ng-if=\"msg.payload.status === 'Stable'\">🟢 SYSTÈME EN VEILLE - PATIENT STABLE</span>\n    </div>\n\n    <div ng-init=\"$root.derniereVideoId = ''; $root.horodatageVideo = ''\">\n        <div ng-if=\"msg.payload.video_file\">\n            {{$root.derniereVideoId = msg.payload.video_file; ''}}\n            {{$root.horodatageVideo = msg.payload.timestamp; ''}}\n        </div>\n    </div>\n\n    <div ng-if=\"$root.derniereVideoId\">\n        <h4 style=\"color: #ffaa00; margin-top: 10px;\">🎥 DERNIER INCIDENT ENREGISTRÉ (LEVÉE DE DOUTE)</h4>\n\n        <video width=\"100%\" height=\"auto\" controls autoplay ng-src=\"../{{$root.derniereVideoId}}\"\n            style=\"border: 2px solid #ffaa00; border-radius: 4px;\">\n            Votre navigateur ne supporte pas ce format vidéo.\n        </video>\n\n        <p style=\"font-size: 0.85em; color: #aaa; margin-top: 5px;\">\n            Fichier : {{$root.derniereVideoId}} <br>\n            Détecté le : {{$root.horodatageVideo}}\n        </p>\n    </div>\n\n    <div ng-if=\"!$root.derniereVideoId\">\n        <p style=\"color: #888; font-style: italic;\">Aucun historique vidéo pour le moment.</p>\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
